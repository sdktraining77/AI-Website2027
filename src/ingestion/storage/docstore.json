ining-center-rag\\src\\ingestion\\..\\..\\data\\data-analysis.md", "file_name": "data-analysis.md", "file_type": "text/markdown", "file_size": 1099, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}}, "e4f84efb-b027-49af-8d15-93bcf6bd75b8": {"node_ids": ["445684c6-5c7f-4b27-9096-5619102b7f27", "f77bc578-1698-48ab-9fef-ac858e282e58", "601de9a9-4fa4-4838-b1b3-fbed968632bc"], "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\faq.md", "file_name": "faq.md", "file_type": "text/markdown", "file_size": 1984, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}}, "86aba96e-62aa-42c9-926f-8ecf46051ea8": {"node_ids": ["be236ec7-94e3-4ba5-9088-dec07d75b35b", "9d385e90-1b44-4b4c-9f61-37753df65e20"], "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\registration.md", "file_name": "registration.md", "file_type": "text/markdown", "file_size": 1238, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}}, "d867cd19-6bb7-483e-97ba-a09e966dfec1": {"node_ids": ["215febcd-c670-4b58-a306-161843f8e058"], "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\web-development.md", "file_name": "web-development.md", "file_type": "text/markdown", "file_size": 1094, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}}}, "docstore/data": {"eef874fc-9e36-4394-90f0-3bd1b48b5f63": {"__data__": {"id_": "eef874fc-9e36-4394-90f0-3bd1b48b5f63", "embedding": null, "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\about.md", "file_name": "about.md", "file_type": "text/markdown", "file_size": 977, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "6dd2e403-c0f4-4787-a7bc-fab73d96e543", "node_type": "4", "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\about.md", "file_name": "about.md", "file_type": "text/markdown", "file_size": 977, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "hash": "a4d40a515bac9a140be55f777f04fc1e2292bc0373cc710f4ef320b1ff7b6036", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "# About TechBridge Training Center\n\n## Overview\nTechBridge Training Center is a fictional training center that helps students and professionals develop practical technology skills. The center offers instructor-led courses, hands-on exercises, and small projects.\n\n## Mission\nOur mission is to make technology education accessible and practical, helping learners build skills they can use in academic projects and the workplace.\n\n## Training Format\n- Courses are delivered in person at the TechBridge training facility.\n- Classes are held three days per week.\n- Each class lasts two hours.\n- Students complete practical exercises and a final course project.\n- Course materials are provided digitally.\n\n## Available Courses\n1. Artificial Intelligence (AI)\n2. Web Development\n3. Data Analysis\n\n## Contact Information\n- Email: info@techbridge.example\n- Phone: +962 6 555 0140\n- Address: 25 University Street, Amman, Jordan\n\n## Working Hours\nSunday to Thursday, 9:00 AM to 5:00 PM.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 976, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "f8abd275-eb55-4cef-9afd-171d9c60a7a7": {"__data__": {"id_": "f8abd275-eb55-4cef-9afd-171d9c60a7a7", "embedding": null, "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\ai-course.md", "file_name": "ai-course.md", "file_type": "text/markdown", "file_size": 1104, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "fca78e50-e015-41e4-af87-f2679f6cb6f7", "node_type": "4", "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\ai-course.md", "file_name": "ai-course.md", "file_type": "text/markdown", "file_size": 1104, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "hash": "4c021443341991ea750733c3b4fbdd6e518adb06c77850fe2f661d710dfab6b5", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "# Artificial Intelligence Course\n\n## Course Name\nPractical Artificial Intelligence\n\n## Description\nThis course introduces learners to the foundations of Artificial Intelligence and Machine Learning. Students explore how AI systems learn from data, practice preparing datasets, train simple machine learning models, and evaluate model performance. The course includes hands-on exercises using Python.\n\n## Duration\n8 weeks (48 training hours).\n\n## Prerequisites\n- Basic computer skills.\n- Basic Python programming knowledge.\n- Basic understanding of mathematics is helpful but not required.\n\n## Target Audience\n- University students interested in AI.\n- Beginner programmers who want to explore machine learning.\n- Professionals who want an introduction to practical AI.\n\n## Learning Outcomes\nBy the end of the course, students will be able to:\n- Explain basic AI and machine learning concepts.\n- Prepare a simple dataset for analysis.\n- Train and evaluate a basic machine learning model.\n- Present a small AI project.\n\n## Schedule\nSunday, Tuesday, and Thursday, 4:00 PM to 6:00 PM.\n\n## Course Fee\n180 JOD.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 1103, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "ab5baac7-0402-49bc-88ac-f956c78d7a7f": {"__data__": {"id_": "ab5baac7-0402-49bc-88ac-f956c78d7a7f", "embedding": null, "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\data-analysis.md", "file_name": "data-analysis.md", "file_type": "text/markdown", "file_size": 1099, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "04b612bb-4c5b-4882-a381-230a9d8bb33b", "node_type": "4", "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\data-analysis.md", "file_name": "data-analysis.md", "file_type": "text/markdown", "file_size": 1099, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "hash": "2a5557babfd97ef040170eac5ecb847c3dfd7a553af654d7b0ff79cbbd4eea1b", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "# Data Analysis Course\n\n## Course Name\nData Analysis with Python and Power BI\n\n## Description\nThis course teaches learners how to turn raw data into useful insights. Students learn data collection basics, data cleaning, exploratory data analysis, and visualization. They use Python with Pandas for data preparation and Power BI to create interactive dashboards. The final activity is a small data analysis project.\n\n## Duration\n6 weeks (36 training hours).\n\n## Prerequisites\n- Basic computer skills.\n- Basic spreadsheet knowledge is recommended.\n- No previous Python experience is required.\n\n## Target Audience\n- University students interested in data.\n- Beginners who want to learn data analysis.\n- Professionals who work with reports and business data.\n\n## Learning Outcomes\nBy the end of the course, students will be able to:\n- Identify common data quality issues.\n- Clean and organize datasets.\n- Perform basic exploratory data analysis.\n- Create charts and dashboards.\n- Communicate findings using data.\n\n## Schedule\nMonday, Wednesday, and Thursday, 4:00 PM to 6:00 PM.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 1074, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "225a8688-1a91-48e7-87b6-c29e7deec197": {"__data__": {"id_": "225a8688-1a91-48e7-87b6-c29e7deec197", "embedding": null, "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\data-analysis.md", "file_name": "data-analysis.md", "file_type": "text/markdown", "file_size": 1099, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "04b612bb-4c5b-4882-a381-230a9d8bb33b", "node_type": "4", "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\data-analysis.md", "file_name": "data-analysis.md", "file_type": "text/markdown", "file_size": 1099, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "hash": "2a5557babfd97ef040170eac5ecb847c3dfd7a553af654d7b0ff79cbbd4eea1b", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "ab5baac7-0402-49bc-88ac-f956c78d7a7f", "node_type": "1", "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\data-analysis.md", "file_name": "data-analysis.md", "file_type": "text/markdown", "file_size": 1099, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "hash": "ebc6504713717a7f010687e795fe48ab7facc34b9c02380cfe59673347d79f18", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "- Communicate findings using data.\n\n## Schedule\nMonday, Wednesday, and Thursday, 4:00 PM to 6:00 PM.\n\n## Course Fee\n160 JOD.", "mimetype": "text/plain", "start_char_idx": null, "end_char_idx": null, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "445684c6-5c7f-4b27-9096-5619102b7f27": {"__data__": {"id_": "445684c6-5c7f-4b27-9096-5619102b7f27", "embedding": null, "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\faq.md", "file_name": "faq.md", "file_type": "text/markdown", "file_size": 1984, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "e4f84efb-b027-49af-8d15-93bcf6bd75b8", "node_type": "4", "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\faq.md", "file_name": "faq.md", "file_type": "text/markdown", "file_size": 1984, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "hash": "dd838721bdf0d7a018cfcbe03d87df051c19cd395e765e274ef6b3199196cea2", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "# Frequently Asked Questions (FAQ)\n\n## 1. Where is TechBridge Training Center located?\nThe center is located at 25 University Street, Amman, Jordan.\n\n## 2. What courses are available?\nThe center offers Practical Artificial Intelligence, Full-Stack Web Development Fundamentals, and Data Analysis with Python and Power BI.\n\n## 3. Do I need programming experience to join the AI course?\nYes. Basic Python programming knowledge is a prerequisite for the Practical Artificial Intelligence course.\n\n## 4. Do I need programming experience to join the Web Development course?\nNo. The Web Development course is designed for beginners and does not require previous programming experience.\n\n## 5. Do I need Python experience for the Data Analysis course?\nNo. Previous Python experience is not required. Basic spreadsheet knowledge is recommended.\n\n## 6. How long is the AI course?\nThe Practical Artificial Intelligence course lasts 8 weeks, with 48 training hours.\n\n## 7. How long is the Web Development course?", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 1001, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "f77bc578-1698-48ab-9fef-ac858e282e58": {"__data__": {"id_": "f77bc578-1698-48ab-9fef-ac858e282e58", "embedding": null, "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\faq.md", "file_name": "faq.md", "file_type": "text/markdown", "file_size": 1984, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "e4f84efb-b027-49af-8d15-93bcf6bd75b8", "node_type": "4", "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\faq.md", "file_name": "faq.md", "file_type": "text/markdown", "file_size": 1984, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "hash": "dd838721bdf0d7a018cfcbe03d87df051c19cd395e765e274ef6b3199196cea2", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "445684c6-5c7f-4b27-9096-5619102b7f27", "node_type": "1", "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\faq.md", "file_name": "faq.md", "file_type": "text/markdown", "file_size": 1984, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "hash": "590e2201fc814e37f35db042f504d772263988671438a4e1d36fdc97a4903464", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "The Practical Artificial Intelligence course lasts 8 weeks, with 48 training hours.\n\n## 7. How long is the Web Development course?\nThe Full-Stack Web Development Fundamentals course lasts 10 weeks, with 60 training hours.\n\n## 8. How long is the Data Analysis course?\nThe Data Analysis with Python and Power BI course lasts 6 weeks, with 36 training hours.\n\n## 9. Are the courses online?\nNo. Courses are delivered in person at the TechBridge training facility.\n\n## 10. How can I register?\nYou can visit the center or email info@techbridge.example. Complete the registration form, provide the required information, and pay the course fee.\n\n## 11. When is my place confirmed?\nYour place is confirmed after the registration information is submitted and payment is completed.\n\n## 12. Can I cancel my registration?\nYou can request a cancellation up to seven days before the course starts. Approved requests receive a full refund.\n\n## 13. Does the center provide course materials?\nYes.", "mimetype": "text/plain", "start_char_idx": null, "end_char_idx": null, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "601de9a9-4fa4-4838-b1b3-fbed968632bc": {"__data__": {"id_": "601de9a9-4fa4-4838-b1b3-fbed968632bc", "embedding": null, "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\faq.md", "file_name": "faq.md", "file_type": "text/markdown", "file_size": 1984, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "e4f84efb-b027-49af-8d15-93bcf6bd75b8", "node_type": "4", "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\faq.md", "file_name": "faq.md", "file_type": "text/markdown", "file_size": 1984, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "hash": "dd838721bdf0d7a018cfcbe03d87df051c19cd395e765e274ef6b3199196cea2", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "f77bc578-1698-48ab-9fef-ac858e282e58", "node_type": "1", "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\faq.md", "file_name": "faq.md", "file_type": "text/markdown", "file_size": 1984, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "hash": "4d4d9e02bccaf36ce6f8c42e8d3be5feae7b897a4697edf79155b514e5bf0d63", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Approved requests receive a full refund.\n\n## 13. Does the center provide course materials?\nYes. Course materials are provided digitally.\n\n## 14. How can I contact the center?\nEmail info@techbridge.example or call +962 6 555 0140.", "mimetype": "text/plain", "start_char_idx": null, "end_char_idx": null, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "be236ec7-94e3-4ba5-9088-dec07d75b35b": {"__data__": {"id_": "be236ec7-94e3-4ba5-9088-dec07d75b35b", "embedding": null, "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\registration.md", "file_name": "registration.md", "file_type": "text/markdown", "file_size": 1238, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "86aba96e-62aa-42c9-926f-8ecf46051ea8", "node_type": "4", "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\registration.md", "file_name": "registration.md", "file_type": "text/markdown", "file_size": 1238, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "hash": "61873441d3021b5082d0bbbe08b4ceb723abe8b46c0c78efa54dc9099fc110fd", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "# Registration Process\n\n## How to Register\nApplicants can register for a course by following these steps:\n\n1. Visit the TechBridge Training Center or email info@techbridge.example.\n2. Choose one of the available courses.\n3. Complete the registration form with your full name, email address, phone number, and selected course.\n4. Provide any information needed to confirm that you meet the course prerequisites.\n5. Pay the course fee at the center.\n6. Receive a confirmation email with the course schedule and start date.\n\n## Registration Requirements\n- Applicants must provide accurate contact information.\n- Applicants should review the prerequisites before registering.\n- Some courses may require a short placement discussion to check the learner's starting level.\n\n## Payment\nPayment is made in Jordanian dinars (JOD) at the training center. A place is confirmed after payment is completed.\n\n## Cancellation Policy\nApplicants may request a cancellation up to seven days before the course start date. Approved cancellations receive a full refund.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 1048, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "9d385e90-1b44-4b4c-9f61-37753df65e20": {"__data__": {"id_": "9d385e90-1b44-4b4c-9f61-37753df65e20", "embedding": null, "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\registration.md", "file_name": "registration.md", "file_type": "text/markdown", "file_size": 1238, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "86aba96e-62aa-42c9-926f-8ecf46051ea8", "node_type": "4", "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\registration.md", "file_name": "registration.md", "file_type": "text/markdown", "file_size": 1238, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "hash": "61873441d3021b5082d0bbbe08b4ceb723abe8b46c0c78efa54dc9099fc110fd", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "be236ec7-94e3-4ba5-9088-dec07d75b35b", "node_type": "1", "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\registration.md", "file_name": "registration.md", "file_type": "text/markdown", "file_size": 1238, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "hash": "d77687594dbd081c37da8a75987fab2dddcb093adb4889bbef68f6f587c44151", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Approved cancellations receive a full refund. Requests made fewer than seven days before the start date are reviewed by the administration.\n\n## Contact\nFor registration questions, email info@techbridge.example or call +962 6 555 0140.", "mimetype": "text/plain", "start_char_idx": null, "end_char_idx": null, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "215febcd-c670-4b58-a306-161843f8e058": {"__data__": {"id_": "215febcd-c670-4b58-a306-161843f8e058", "embedding": null, "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\web-development.md", "file_name": "web-development.md", "file_type": "text/markdown", "file_size": 1094, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "d867cd19-6bb7-483e-97ba-a09e966dfec1", "node_type": "4", "metadata": {"file_path": "C:\\Users\\USER\\OneDrive\\Desktop\\AI_chatbot\\training-center-rag\\src\\ingestion\\..\\..\\data\\web-development.md", "file_name": "web-development.md", "file_type": "text/markdown", "file_size": 1094, "creation_date": "2026-11-17", "last_modified_date": "2026-11-17"}, "hash": "5b9f3799041bd5c787654c1c1501483baeb0f5f8e6857d25e98ca82e9a8d77c6", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "# Web Development Course\n\n## Course Name\nFull-Stack Web Development Fundamentals\n\n## Description\nThis course teaches students how to build interactive websites. Learners start with HTML and CSS, then study JavaScript and basic front-end development. They are introduced to server-side concepts and learn how a website communicates with a database. The course ends with a small website project.\n\n## Duration\n10 weeks (60 training hours).\n\n## Prerequisites\n- Basic computer and internet skills.\n- No previous programming experience is required.\n\n## Target Audience\n- Beginners interested in building websites.\n- University students who want practical web development skills.\n- People preparing to pursue a career in front-end or full-stack development.\n\n## Learning Outcomes\nBy the end of the course, students will be able to:\n- Create web pages using HTML.\n- Style pages using CSS.\n- Add interactivity using JavaScript.\n- Understand basic server and database concepts.\n- Build and present a simple website.\n\n## Schedule\nSunday, Tuesday, and Thursday, 5:00 PM to 7:00 PM.\n\n## Course Fee\n200 JOD.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 1093, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}}}